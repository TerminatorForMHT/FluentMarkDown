<Window
    x:Class="FluentMarkDown.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    Title="FluentMarkDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 标题栏 -->
            <RowDefinition Height="Auto"/>   <!-- 命令栏 -->
            <RowDefinition Height="*"/>      <!-- 主内容 -->
            <RowDefinition Height="Auto"/>   <!-- 状态栏 -->
        </Grid.RowDefinitions>

        <!-- ════════ 自定义标题栏 ════════ -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48" Padding="16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Image Source="ms-appx:///Assets/app_icon.png" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="TitleText" Grid.Column="1"
                       Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       VerticalAlignment="Center" Opacity="0.8"/>
        </Grid>

        <!-- ════════ 命令栏 ════════ -->
        <CommandBar Grid.Row="1" DefaultLabelPosition="Collapsed"
                    Background="Transparent" IsOpen="False">

            <!-- 文件操作 -->
            <AppBarButton Icon="Add" Label="新建" ToolTipService.ToolTip="新建 (Ctrl+N)"
                          Command="{x:Bind ViewModel.NewFileCommand}"/>
            <AppBarButton Icon="OpenFile" Label="打开" ToolTipService.ToolTip="打开 (Ctrl+O)"
                          Click="OnOpenFileClick"/>
            <AppBarButton Icon="Save" Label="保存" ToolTipService.ToolTip="保存 (Ctrl+S)"
                          Click="OnSaveFileClick"/>
            <AppBarButton Icon="SaveLocal" Label="另存为" ToolTipService.ToolTip="另存为 (Ctrl+Shift+S)"
                          Click="OnSaveAsClick"/>

            <AppBarSeparator/>

            <!-- 格式 -->
            <AppBarButton Icon="Bold" Label="加粗" ToolTipService.ToolTip="加粗 (Ctrl+B)"
                          Click="OnBoldClick" IsEnabled="{x:Bind ViewModel.HasDocument, Mode=OneWay}"/>
            <AppBarButton Icon="Italic" Label="斜体" ToolTipService.ToolTip="斜体 (Ctrl+I)"
                          Click="OnItalicClick" IsEnabled="{x:Bind ViewModel.HasDocument, Mode=OneWay}"/>
            <AppBarElementContainer>
                <AppBarButton Icon="Code" Label="代码" ToolTipService.ToolTip="行内代码 (Ctrl+Shift+K)"
                              Click="OnCodeClick" IsEnabled="{x:Bind ViewModel.HasDocument, Mode=OneWay}"/>
            </AppBarElementContainer>
            <AppBarButton Icon="Link" Label="链接" ToolTipService.ToolTip="链接 (Ctrl+K)"
                          Click="OnLinkClick" IsEnabled="{x:Bind ViewModel.HasDocument, Mode=OneWay}"/>

            <AppBarSeparator/>

            <!-- 视图 -->
            <AppBarButton Icon="FullScreen" Label="全屏预览" ToolTipService.ToolTip="全屏预览 (F11)"
                          Command="{x:Bind ViewModel.TogglePreviewFullscreenCommand}"
                          IsEnabled="{x:Bind ViewModel.HasDocument, Mode=OneWay}"/>
            <AppBarButton Icon="Edit" Label="全屏编辑" ToolTipService.ToolTip="全屏编辑 (Ctrl+Shift+E)"
                          Command="{x:Bind ViewModel.ToggleEditorFullscreenCommand}"
                          IsEnabled="{x:Bind ViewModel.HasDocument, Mode=OneWay}"/>

            <AppBarSeparator/>

            <!-- 预览主题 -->
            <AppBarElementContainer>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="主题" VerticalAlignment="Center" FontSize="12" Opacity="0.7"/>
                    <ComboBox x:Name="ThemeCombo" Width="120"
                              ItemsSource="{x:Bind ViewModel.Themes}"
                              SelectedValuePath="Id"
                              SelectedValue="{x:Bind ViewModel.CurrentTheme, Mode=TwoWay}"
                              SelectionChanged="OnThemeChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </AppBarElementContainer>

            <AppBarSeparator/>

            <!-- 导出 -->
            <AppBarButton Icon="Share" Label="导出" ToolTipService.ToolTip="导出为 PDF / Word / HTML"
                          Click="OnExportClick" IsEnabled="{x:Bind ViewModel.HasDocument, Mode=OneWay}"/>

            <CommandBar.SecondaryCommands>
                <AppBarButton Icon="Find" Label="查找替换" ToolTipService.ToolTip="查找 (Ctrl+F)"
                              Click="OnFindClick"/>
                <AppBarButton Icon="Setting" Label="设置" Click="OnSettingsClick"/>
                <AppBarButton Label="关于" Click="OnAboutClick">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE946;"/>
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBar.SecondaryCommands>
        </CommandBar>

        <!-- ════════ 主内容区 ════════ -->
        <Grid Grid.Row="2">
            <!-- 欢迎页 -->
            <Grid x:Name="WelcomePanel" Visibility="Visible">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                    <FontIcon Glyph="&#xE8A5;" FontSize="64" HorizontalAlignment="Center" Opacity="0.5"/>
                    <TextBlock Text="FluentMarkDown" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="新建或打开 Markdown 文件开始编辑" FontSize="16" Opacity="0.6" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" Margin="0,16,0,0">
                        <Button Content="新建文件" Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.NewFileCommand}"/>
                        <Button Content="打开文件" Click="OnOpenFileClick"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="24" HorizontalAlignment="Center" Margin="0,24,0,0" Opacity="0.5">
                        <TextBlock Text="Ctrl+N 新建" FontSize="12"/>
                        <TextBlock Text="Ctrl+O 打开" FontSize="12"/>
                        <TextBlock Text="Ctrl+S 保存" FontSize="12"/>
                        <TextBlock Text="Ctrl+F 查找" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- 编辑器 + 预览分栏 -->
            <Grid x:Name="EditorPanel" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="EditorColumn" Width="*"/>
                    <ColumnDefinition x:Name="PreviewColumn" Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Monaco 编辑器 (WebView2) -->
                <controls:WebView2 x:Name="EditorWebView" Grid.Column="0"
                                   DefaultBackgroundColor="Transparent"
                                   NavigationStarting="OnEditorNavigationStarting"/>

                <!-- 分割条 -->
                <Grid Grid.Column="0" HorizontalAlignment="Right" Width="4"
                      Background="Transparent" ManipulationMode="TranslateX"
                      PointerPressed="OnSplitterPointerPressed"
                      PointerMoved="OnSplitterPointerMoved"
                      PointerReleased="OnSplitterPointerReleased"/>

                <!-- 预览 (WebView2) -->
                <controls:WebView2 x:Name="PreviewWebView" Grid.Column="1"
                                   DefaultBackgroundColor="Transparent"/>
            </Grid>

            <!-- AI 侧边面板 -->
            <Grid x:Name="AiPanel"
                  HorizontalAlignment="Right" Width="380"
                  Visibility="{x:Bind ViewModel.IsAiPanelOpen, Mode=OneWay}"
                  Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- AI 标题 -->
                <Grid Grid.Row="0" Padding="16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🤖 AI 助手" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                        <Button Content="清空" FontSize="12" Click="OnClearAiClick" Padding="8,4"/>
                        <Button Content="✕" Click="OnCloseAiClick" Padding="8,4"/>
                    </StackPanel>
                </Grid>

                <!-- AI 对话历史 -->
                <ScrollViewer Grid.Row="1" Padding="16,0">
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.AiHistory, Mode=OneWay}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}" TextWrapping="Wrap"
                                           Margin="0,6" FontSize="13" IsTextSelectionEnabled="True"/>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>

                <!-- AI 实时输出 -->
                <Border Grid.Row="1" VerticalAlignment="Bottom" Padding="16,8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8" Margin="16,8" 
                        Visibility="{x:Bind ViewModel.IsAiBusy, Mode=OneWay}">
                    <TextBlock Text="{x:Bind ViewModel.AiOutput, Mode=OneWay}"
                               TextWrapping="Wrap" FontSize="13" MaxHeight="200"
                               TextTrimming="CharacterEllipsis"/>
                </Border>

                <!-- AI 输入 -->
                <Grid Grid.Row="2" Padding="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="AiInputBox" PlaceholderText="输入你的需求..."
                             Text="{x:Bind ViewModel.AiInput, Mode=TwoWay}"
                             AcceptsReturn="False"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0">
                        <Button Content="发送" Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.SendAiMessageCommand}"/>
                        <Button Content="插入" ToolTipService.ToolTip="插入到编辑器"
                                Command="{x:Bind ViewModel.InsertAiOutputCommand}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- ════════ 状态栏 ════════ -->
        <Grid Grid.Row="3" Height="28" Padding="16,0"
              Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" FontSize="12" Opacity="0.7"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
                <TextBlock FontSize="12" Opacity="0.7">
                    <Run Text="字符: "/><Run Text="{x:Bind ViewModel.CharCount, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock FontSize="12" Opacity="0.7">
                    <Run Text="行数: "/><Run Text="{x:Bind ViewModel.LineCount, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock FontSize="12" Opacity="0.7" Text="UTF-8"/>
            </StackPanel>
        </Grid>

        <!-- AI 悬浮按钮 -->
        <Button x:Name="AiFloatButton"
                Grid.Row="2"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,20,20" Width="48" Height="48"
                CornerRadius="24"
                Style="{StaticResource AccentButtonStyle}"
                Command="{x:Bind ViewModel.ToggleAiPanelCommand}"
                ToolTipService.ToolTip="AI 助手">
            <FontIcon Glyph="&#xE99A;" FontSize="20"/>
        </Button>
    </Grid>
</Window>
